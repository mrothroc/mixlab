+  // also protects the existing free-stream synchronization in clear_cache().
+  cudaStreamCaptureStatus capture;
+  CHECK_CUDA_ERROR(cudaStreamIsCapturing(stream, &capture));
+  if (capture != cudaStreamCaptureStatusNone) {
+    log_pressure(size, device, stream, "capture-no-retry", status);
+    CHECK_CUDA_ERROR(status);
+  }
