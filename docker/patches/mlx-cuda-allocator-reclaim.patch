+void* CudaAllocator::allocate_device(size_t size, int device, cudaStream_t stream) {
+  void* data = nullptr;
+  auto allocate = [&]() {
+    return mem_pools_[device] ? cudaMallocAsync(&data, size, stream) : cudaMalloc(&data, size);
+  };
