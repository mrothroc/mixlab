+void log_strict_conv_fallback(
+    const array& in, const array& wt, const array& out,
+    const std::vector<int>& strides, const std::vector<int>& padding,
+    const std::vector<int>& dilation, const std::vector<int>& input_dilation,
+    bool flip) {
+  if (out.dtype() != float32 || env::enable_tf32()) return;
+  std::ostringstream line;
+  line << "[mlx conv] fallback=gemm operation=Convolution precision=strict-fp32"
+       << " reason=no-supported-cudnn-plan";
+  auto field = [&](const char* name, const auto& values) {
+    line << " " << name << "=[";
+    const char* separator = "";
+    for (auto value : values) { line << separator << value; separator = ","; }
+    line << "]";
+  };
+  field("input", in.shape()); field("weight", wt.shape()); field("output", out.shape());
+  field("stride", strides); field("padding", padding); field("dilation", dilation);
+  field("input_dilation", input_dilation);
+  line << " flip=" << flip;
+  // Bound diagnostic state independently of the execution-plan cache. Avoid
+  // repeated messages when pointer alignment or cache eviction changes keys.
+  static std::mutex mutex;
+  static std::unordered_set<std::string> seen;
+  std::lock_guard<std::mutex> lock(mutex);
+  if (seen.size() < 256 && seen.insert(line.str()).second) {
+    std::cerr << line.str() << std::endl;
+    if (seen.size() == 256) std::cerr << "[mlx conv] further fallback signatures suppressed" << std::endl;
+  }
+}
