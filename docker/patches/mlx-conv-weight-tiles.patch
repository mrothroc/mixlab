+int conv_weight_patch_batch(const array& in, const array& wt, const array& cotan) {
+  // Divide the budget instead of multiplying dimensions, which can overflow.
+  // One record is the minimum tile even when it exceeds the target budget.
+  const int batch = in.shape(0);
+  if (in.dtype() != float32 || batch <= 1) return batch;
+  size_t records = (256ULL << 20) / sizeof(float);
+  size_t untiled_records = (2ULL << 30) / sizeof(float);
+  for (int axis = 1; axis < cotan.ndim() - 1; ++axis) {
+    if (cotan.shape(axis) <= 0) return batch;
+    records /= size_t(cotan.shape(axis));
+    untiled_records /= size_t(cotan.shape(axis));
+  }
+  for (int axis = 1; axis < wt.ndim(); ++axis) {
+    if (wt.shape(axis) <= 0) return batch;
+    records /= size_t(wt.shape(axis));
+    untiled_records /= size_t(wt.shape(axis));
+  }
+  if (size_t(batch) <= untiled_records) return batch;
+  return int(std::max<size_t>(1, std::min<size_t>(records, batch)));
+}
