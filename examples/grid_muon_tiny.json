{
  "name": "grid_muon_tiny",
  "input_adapter": {
    "kind": "grid",
    "channels": 2,
    "height": 8,
    "width": 8
  },
  "dense_regression": {
    "output": "network.output",
    "target_channels": 1
  },
  "blocks": [
    {
      "type": "custom",
      "name": "network",
      "weights": [
        {
          "name": "stem.weight",
          "shape": [
            "3",
            "3",
            "3",
            "2"
          ],
          "init": {
            "kind": "pytorch_conv_uniform"
          }
        },
        {
          "name": "stem.bias",
          "shape": [
            "3"
          ],
          "init": {
            "kind": "pytorch_conv_uniform",
            "weight": "stem.weight"
          }
        },
        {
          "name": "down.weight",
          "shape": [
            "4",
            "2",
            "2",
            "3"
          ],
          "init": {
            "kind": "pytorch_conv_uniform"
          }
        },
        {
          "name": "down.bias",
          "shape": [
            "4"
          ],
          "init": {
            "kind": "pytorch_conv_uniform",
            "weight": "down.weight"
          }
        },
        {
          "name": "up.weight",
          "shape": [
            "4",
            "2",
            "2",
            "3"
          ],
          "init": {
            "kind": "pytorch_conv_uniform"
          }
        },
        {
          "name": "up.bias",
          "shape": [
            "3"
          ],
          "init": {
            "kind": "pytorch_conv_uniform",
            "weight": "up.weight"
          }
        },
        {
          "name": "output.weight",
          "shape": [
            "1",
            "1",
            "1",
            "3"
          ],
          "init": {
            "kind": "pytorch_conv_uniform"
          }
        },
        {
          "name": "output.bias",
          "shape": [
            "1"
          ],
          "init": {
            "kind": "pytorch_conv_uniform",
            "weight": "output.weight"
          }
        }
      ],
      "ops": [
        {
          "op": "conv2d",
          "inputs": [
            "x",
            "stem.weight",
            "stem.bias"
          ],
          "output": "stem",
          "params": {
            "kernel": 3,
            "stride": 1,
            "padding": 1
          }
        },
        {
          "op": "conv2d",
          "inputs": [
            "stem",
            "down.weight",
            "down.bias"
          ],
          "output": "down",
          "params": {
            "kernel": 2,
            "stride": 2,
            "padding": 0
          }
        },
        {
          "op": "conv_transpose2d",
          "inputs": [
            "down",
            "up.weight",
            "up.bias"
          ],
          "output": "up",
          "params": {
            "kernel": 2,
            "stride": 2,
            "padding": 0
          }
        },
        {
          "op": "conv2d",
          "inputs": [
            "up",
            "output.weight",
            "output.bias"
          ],
          "output": "output",
          "params": {
            "kernel": 1,
            "stride": 1,
            "padding": 0
          }
        }
      ]
    }
  ],
  "training": {
    "objective": "dense_regression",
    "batch_size": 2,
    "steps": 200,
    "optimizer": "muon",
    "lr": 0.001,
    "matrix_lr": 0.001,
    "scalar_lr": 0.001,
    "weight_decay": 0,
    "muon_exclude": [
      "stem",
      "output"
    ],
    "muon_backend_steps": 5,
    "muon_nesterov": true,
    "grad_clip": 1,
    "seed": 42
  }
}
