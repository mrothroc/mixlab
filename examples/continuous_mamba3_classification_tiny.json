{
  "name": "continuous_mamba3_classification_tiny",
  "model_dim": 32,
  "seq_len": 64,
  "positional_embedding": "none",
  "input_adapter": {
    "kind": "linear_frames",
    "feature_dim": 4,
    "bias": true,
    "norm": "layernorm"
  },
  "mlp_mult": 2.0,
  "blocks": [
    {
      "type": "mamba3-canonical",
      "inner_dim": 32,
      "state_size": 8,
      "n_groups": 4,
      "scan_chunk_size": 32
    },
    {"type": "swiglu"}
  ],
  "training": {
    "objective": "classification",
    "classification": {
      "num_labels": 3,
      "pooling": "last",
      "classifier_dropout": 0.1
    },
    "optimizer": "adamw",
    "steps": 100,
    "lr": 0.0003,
    "grad_clip": 1.0,
    "weight_decay": 0.01,
    "batch_tokens": 128,
    "seed": 42
  }
}
