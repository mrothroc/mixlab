{
  "name": "continuous_s4d_batchnorm_reference_tiny",
  "model_dim": 32,
  "seq_len": 64,
  "positional_embedding": "none",
  "norm_type": "batchnorm",
  "norm_eps": 1e-5,
  "batchnorm_momentum": 0.1,
  "norm_placement": "pre",
  "input_adapter": {
    "kind": "linear_frames",
    "feature_dim": 4,
    "bias": true,
    "norm": "layernorm"
  },
  "mlp_mult": 2.0,
  "blocks": [
    {
      "type": "s4d",
      "state_size": 64,
      "init": "s4d-lin",
      "dt_min": 0.001,
      "dt_max": 0.1,
      "output_transform": "glu"
    },
    {"type": "swiglu"}
  ],
  "training": {
    "objective": "classification",
    "classification": {
      "num_labels": 3,
      "pooling": "last",
      "classifier_dropout": 0.1
    },
    "optimizer": "adamw",
    "steps": 100,
    "lr": 0.0003,
    "scalar_lr": 0.0001,
    "grad_clip": 1.0,
    "weight_decay": 0.01,
    "batch_tokens": 128,
    "seed": 42
  }
}
