{
  "name": "grid_polar_tiny",
  "input_adapter": {"kind": "grid", "channels": 2, "height": 8, "width": 8, "vector_dim": 2},
  "dense_regression": {"output": "network.prediction", "target_channels": 1},
  "blocks": [{
    "type": "custom", "name": "network",
    "weights": [
      {"name": "radial.weight", "shape": ["2", "1", "3", "2"], "init": {"kind": "pytorch_conv_uniform"}},
      {"name": "radial.bias", "shape": ["2"], "init": {"kind": "pytorch_conv_uniform", "weight": "radial.weight"}},
      {"name": "angular.weight", "shape": ["2", "3", "1", "2"], "init": {"kind": "pytorch_conv_uniform"}},
      {"name": "angular.bias", "shape": ["2"], "init": {"kind": "pytorch_conv_uniform", "weight": "angular.weight"}},
      {"name": "fusion.weight", "shape": ["1", "1", "1", "4"], "init": {"kind": "pytorch_conv_uniform"}},
      {"name": "fusion.bias", "shape": ["1"], "init": {"kind": "pytorch_conv_uniform", "weight": "fusion.weight"}}
    ],
    "ops": [
      {"op": "cartesian_to_polar", "inputs": ["x", "v"], "output": "polar", "params": {"n_rays": 16, "n_r": 12, "dr": 1.0, "tx": [0, 1]}},
      {"op": "pad", "inputs": ["polar"], "output": "radial_pad", "params": {"axis1": [0, 0], "axis2": [1, 1], "mode": "edge"}},
      {"op": "conv2d", "inputs": ["radial_pad", "radial.weight", "radial.bias"], "output": "radial", "params": {"kernel": [1, 3]}},
      {"op": "relu", "inputs": ["radial"], "output": "hidden"},
      {"op": "pad", "inputs": ["hidden"], "output": "angular_pad", "params": {"axis1": [1, 1], "axis2": [0, 0], "mode": "circular"}},
      {"op": "conv2d", "inputs": ["angular_pad", "angular.weight", "angular.bias"], "output": "features", "params": {"kernel": [3, 1]}},
      {"op": "polar_to_cartesian", "inputs": ["features", "v"], "output": "cartesian", "params": {"n_rays": 16, "dr": 1.0, "height": 8, "width": 8, "tx": [0, 1]}},
      {"op": "concat", "inputs": ["x", "cartesian"], "output": "fusion", "params": {"axis": 3}},
      {"op": "conv2d", "inputs": ["fusion", "fusion.weight", "fusion.bias"], "output": "prediction", "params": {"kernel": 1}}
    ]
  }],
  "training": {
    "objective": "dense_regression", "batch_size": 2, "steps": 40,
    "optimizer": "adamw", "lr": 0.01, "beta1": 0.9, "beta2": 0.999,
    "epsilon": 1e-8, "weight_decay": 0.0, "allow_tf32": false, "seed": 42
  }
}
