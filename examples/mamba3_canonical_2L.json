{
  "name": "mamba3_canonical_2L",

  // Two-layer canonical Mamba-3 state-space example.
  "model_dim": 64,
  "vocab_size": 1024,
  "seq_len": 128,

  // Canonical Mamba-3 blocks provide sequence mixing; SwiGLU provides channel mixing.
  "blocks": [
    {"type": "mamba3-canonical"},
    {"type": "swiglu"},
    {"type": "mamba3-canonical"},
    {"type": "swiglu"}
  ],

  // Lightweight training settings keep this backend path quick to exercise.
  "training": {
    "steps": 50,
    "lr": 3e-4,
    "grad_clip": 1.0,
    "weight_decay": 0.01,
    "seed": 42,
    "batch_tokens": 512
  }
}
