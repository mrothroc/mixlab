{
  "name": "discrete-codebooks-linear-probe-newbob-tiny",
  "model_dim": 64,
  "seq_len": 128,
  "positional_embedding": "none",
  "final_norm": false,
  "input_adapter": {
    "kind": "discrete_codebooks",
    "num_codebooks": 2,
    "codebook_vocab_size": 1024,
    "fusion": "attention_mlp",
    "fusion_hidden_dim": 64,
    "norm": "none"
  },
  "blocks": [],
  "training": {
    "objective": "classification",
    "classification": {
      "num_labels": 10,
      "pooling": "mean",
      "classifier_dropout": 0.0,
      "bias": false
    },
    "optimizer": "adamw",
    "weight_init": "pytorch_linear",
    "batch_tokens": 1024,
    "steps": 1000,
    "lr": 0.0002,
    "lr_schedule": "newbob",
    "newbob": {
      "annealing_factor": 0.9,
      "improvement_threshold": 0.0025,
      "patient": 0,
      "metric": "val_error_rate"
    },
    "val_every_steps": 100,
    "val_examples": 0,
    "grad_clip": 1.0,
    "weight_decay": 0.0,
    "seed": 42
  }
}
