#!/usr/bin/env bash
set -e

echo "pre-commit: running checks..."

# Format check
UNFORMATTED=$(gofmt -l . 2>/dev/null | grep -v vendor/ || true)
if [ -n "$UNFORMATTED" ]; then
    echo "FAIL: gofmt — these files need formatting:"
    echo "$UNFORMATTED"
    echo "  Run: gofmt -w ."
    exit 1
fi

# Lint (includes vet, staticcheck, errcheck, unused, etc.)
#
# golangci-lint runs on the toolchain go.mod names, which CI builds with too.
# golangci-lint typechecks against the standard library of whichever Go it runs
# under, and a Go newer than the one the linter was built with can emit export
# data it cannot decode ("export data version 4 is greater than maximum
# supported version 2"), which drowns real findings in phantom typecheck errors.
# Only the lint step is pinned; gofmt and go test run on the developer's own Go.
# Override with LINT_GOTOOLCHAIN.
LINT_GOTOOLCHAIN="${LINT_GOTOOLCHAIN:-$(sed -n 's/^toolchain //p' go.mod)}"
if [ -z "$LINT_GOTOOLCHAIN" ]; then
    echo "FAIL: go.mod has no toolchain line to lint with"
    exit 1
fi
if command -v golangci-lint &> /dev/null; then
    if ! GOTOOLCHAIN="$LINT_GOTOOLCHAIN" golangci-lint run ./... 2>&1; then
        echo "FAIL: golangci-lint"
        exit 1
    fi
else
    # Fallback to basic vet if golangci-lint not installed. Say so loudly: this
    # drops staticcheck, unused, errcheck, gocritic, unparam, and misspell, so a
    # silent fallback would make a missing tool indistinguishable from a clean
    # lint. Install it with: brew install golangci-lint
    echo "WARNING: golangci-lint not found on PATH — falling back to 'go vet' only."
    echo "         staticcheck/unused/errcheck/gocritic/unparam/misspell are NOT running."
    if ! go vet ./... 2>&1; then
        echo "FAIL: go vet"
        exit 1
    fi
fi

# Tests
if ! go test ./... -count=1 -timeout 600s 2>&1; then
    echo "FAIL: go test"
    exit 1
fi

# File size lint (no Go file over 1000 lines)
OVERSIZED=$(find . -name "*.go" -not -path "./vendor/*" -exec wc -l {} + | sort -rn | awk '$1 > 1000 && $2 != "total" {print $2 " (" $1 " lines)"}')
if [ -n "$OVERSIZED" ]; then
    echo "FAIL: files over 1000 lines:"
    echo "$OVERSIZED"
    exit 1
fi

echo "pre-commit: all checks passed"
